# Oxylabs Web Scraper API credentials. Never commit real values.
OXYLABS_USERNAME=
OXYLABS_PASSWORD=

# Amazon.sa localization.
OXYLABS_DOMAIN=sa
OXYLABS_LOCALE=en_AE
OXYLABS_GEO_LOCATION=

# Optional runtime defaults. CLI flags override these values.
SCRAPER_MODE=test

# Account-agnostic throughput settings. The submit rate is only a probe ceiling;
# HTTP 429 responses automatically tune it downward.
OXYLABS_SUBMIT_RATE=50
SCRAPER_WAVE_SIZE=100
SCRAPER_SEARCH_WAVE_SIZE=18
SCRAPER_POLL_CONCURRENCY=50

# Optional user-defined hard result ceiling. Leave blank to let the provider stop
# the run at its own quota/subscription boundary.
SCRAPER_MAX_RESULTS=
